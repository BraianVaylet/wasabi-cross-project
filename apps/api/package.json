{
  "name": "@wasabi-cross/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de Wasabi Cross — modular monolith, hexagonal-lite.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:ephemeral": "tsx scripts/ephemeral.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/scripts/seed.ts",
    "migrate": "tsx src/scripts/migrate.ts",
    "migrate:dist": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@wasabi-cross/schemas": "workspace:*",
    "better-auth": "^1.7.5",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "^7.0.0",
    "migrate-mongo": "^14.0.7",
    "mongodb": "catalog:",
    "openapi-types": "^12.1.3",
    "pino": "^10.3.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/migrate-mongo": "^14.0.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}

# Copiar a .env para desarrollo local: `pnpm dev`, `migrate` y `seed` lo leen solos.
# NUNCA commitear el .env real (spec §12). En producción no hay .env: las variables las pone
# la plataforma.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

# Mongo local o Atlas. En CI lo reemplaza mongodb-memory-server.
#
# Tiene que ser un REPLICA SET, aunque sea de un solo nodo: el cupo de ejercicios del plan
# usa transacciones (F1-03), y un Mongo standalone no las tiene. Atlas ya es replica set.
# En local, por ejemplo:
#   mongod --replSet rs0 --dbpath ./data   y una sola vez:   mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=wasabi_cross_dev

# Dónde está el front compilado. Con esto la API lo sirve en el mismo origen (ADR-0007). En
# desarrollo va vacío: el front lo sirve Vite.
# WEB_DIST_DIR=../web/dist

# Origen del front, para CORS restrictivo (spec §13).
WEB_ORIGIN=http://localhost:5173

# Secret de sesión de Better Auth. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiame-en-serio-esto-es-solo-un-ejemplo
BETTER_AUTH_URL=http://localhost:3000

# Límite de intentos de login y registro (spec §13: 5/min/IP). `off` sólo para el E2E, que
# registra un atleta por test desde la misma IP. En producción el proceso no levanta con `off`.
AUTH_RATE_LIMIT=on

# El usuario admin de desarrollo (plan Max) que siembra `seed:admin` y, de nuevo en cada
# arranque, `dev:ephemeral`. Sin esto, usa admin@wasabicross.dev / wasabi-cross-admin-dev.
# SEED_ADMIN_EMAIL=admin@wasabicross.dev
# SEED_ADMIN_PASSWORD=wasabi-cross-admin-dev
# SEED_ADMIN_NAME=Admin

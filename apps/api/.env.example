# Copiar a .env para desarrollo local: `pnpm dev`, `migrate` y `seed` lo leen solos.
# NUNCA commitear el .env real (spec §12). En producción no hay .env: las variables las pone
# la plataforma.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=debug

# Mongo local o Atlas. En CI lo reemplaza mongodb-memory-server.
#
# Tiene que ser un REPLICA SET, aunque sea de un solo nodo: el alta de un ejercicio con su
# primera marca usa transacciones (F1-05), y un Mongo standalone no las tiene. Atlas ya es
# replica set.
# En local, por ejemplo:
#   mongod --replSet rs0 --dbpath ./data   y una sola vez:   mongosh --eval "rs.initiate()"
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=wasabi_cross_dev

# Dónde está el front compilado. Con esto la API lo sirve en el mismo origen (ADR-0007). En
# desarrollo va vacío: el front lo sirve Vite.
# WEB_DIST_DIR=../web/dist

# Origen del front, para CORS restrictivo (spec §13).
WEB_ORIGIN=http://localhost:5173

# Secret de sesión de Better Auth. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiame-en-serio-esto-es-solo-un-ejemplo
BETTER_AUTH_URL=http://localhost:3000

# Proveedores de ingreso OAuth 2.0 (spec §5.6, ADR-0012). Es la ÚNICA forma de entrar: no hay email
# ni contraseña, y la API no arranca sin ningún proveedor (Google, Microsoft o el IdP de desarrollo
# de abajo). Cada par va completo o no va: con la mitad, la API no levanta. Sin el par, el
# proveedor queda apagado. Un cliente OAuth por ambiente.
#   Google:    https://console.cloud.google.com  (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google)
#   Microsoft: Microsoft Entra, sólo cuentas personales (redirect URI: <BETTER_AUTH_URL>/api/auth/callback/microsoft)
# Paso a paso, prueba guiada y rotación de secretos: docs/runbooks/oauth.md. El secreto de Microsoft
# vence. Para ver qué claims trae una cuenta real: pnpm --filter @wasabi-cross/api oauth:inspect-token
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# El IdP de desarrollo (F9-03): entrar sin credenciales reales. En `on` por defecto acá: sin él (y
# sin credenciales de Google o Microsoft) la API no arranca. Con NODE_ENV=production el proceso no
# levanta si esto está en `on`: aceptaría a cualquiera. MICROSOFT_AUTHORITY apunta el proveedor de
# Microsoft a ese IdP, y sólo se acepta con OAUTH_DEV_IDP=on.
OAUTH_DEV_IDP=on
# MICROSOFT_AUTHORITY=http://127.0.0.1:3102
# El IdP de desarrollo escucha en 127.0.0.1:3102; FAKE_IDP_PORT lo cambia (p. ej. si corren dos
# `pnpm dev` a la vez). Lo arranca `pnpm dev` (scripts/dev.ts), no la API de producción.
# FAKE_IDP_PORT=3102

# Límite de intentos de ingreso (spec §13: 5/min/IP en /sign-in/social y en los callbacks). `off` sólo para el E2E, que
# registra un atleta por test desde la misma IP. En producción el proceso no levanta con `off`.
AUTH_RATE_LIMIT=on

# El usuario admin de desarrollo (plan Pro) que siembra `seed:admin` y, de nuevo en cada
# arranque, `dev:ephemeral`. Sin contraseña: queda ligado a la cuenta del IdP falso, que lo ofrece
# cargado por defecto (OAUTH_DEV_IDP=on). Sin esto, usa admin@wasabicross.dev / Admin.
# SEED_ADMIN_EMAIL=admin@wasabicross.dev
# SEED_ADMIN_NAME=Admin

{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "test/**/*",
    "scripts/**/*",
    "server/**/*",
    "e2e/**/*",
    "astro.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": ["dist", "dist-e2e", "coverage", "playwright-report", "test-results"]
}

---
// La página de la landing: el hero y, en el orden de la spec §5.7, sus secciones.
import Estadisticas from '../components/Estadisticas.astro';
import Funciones from '../components/Funciones.astro';
import Hero from '../components/Hero.astro';
import Planes from '../components/Planes.astro';
import Registro from '../components/Registro.astro';
import { seo } from '../content/sitio.ts';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout titulo={seo.titulo} descripcion={seo.descripcion} ruta="/">
  <Hero />
  <Registro />
  <Funciones />
  <Estadisticas />
  <Planes />
</BaseLayout>

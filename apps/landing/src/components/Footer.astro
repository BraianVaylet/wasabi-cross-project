---
/*
 * El footer: la marca, su frase y los CTA de cierre, los mismos que los del hero (`CtaPrincipal`).
 */
import { paginasLegales, textos } from '../content/sitio.ts';
import CtaPrincipal from './CtaPrincipal.astro';
import Marca from './Marca.astro';

interface Props {
  /** El enlace a la captura del hero. Las páginas que no la tienen (la 404) lo apagan. */
  demo?: boolean;
}

const { demo = true } = Astro.props;
---

<footer class="pie">
  <div class="presentacion">
    <Marca />
    <p>{textos.pieDescripcion}</p>
    <nav class="legal" aria-label={textos.legal}>
      {paginasLegales.map((p) => (
        <a href={p.ruta}>{p.nombre}</a>
      ))}
    </nav>
  </div>
  <div class="acciones">
    <CtaPrincipal flecha="↗" demo={demo} />
  </div>
</footer>

<style>
  .pie {
    display: flex;
    flex-direction: column;
    gap: var(--wc-space-5);
    max-width: var(--landing-max);
    margin-inline: auto;
    padding: 2.25rem var(--landing-gutter);
  }

  @media (min-width: 48rem) {
    .pie {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding-block: 3rem;
    }
  }

  .presentacion p {
    max-width: 31rem;
    margin: var(--wc-space-2) 0 0;
    color: var(--wc-text-muted);
    font-family: var(--wc-font-family);
    font-size: var(--wc-font-size-caption);
    line-height: 1.25rem;
    text-transform: uppercase;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--wc-space-5);
    margin-top: var(--wc-space-2);
  }

  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: var(--wc-tap-target);
    color: var(--wc-text-soft);
    font-family: var(--wc-font-family);
    font-size: var(--wc-font-size-caption);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-transform: uppercase;
  }

  .acciones {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--wc-space-3);
  }

  @media (min-width: 48rem) {
    .acciones {
      align-items: flex-end;
    }
  }
</style>

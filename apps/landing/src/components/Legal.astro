---
/*
 * Una página legal (F10-09, spec §5.7 y §13): la política de privacidad o los términos. El texto,
 * en `content/legal.ts`; quién responde, de las variables de build (`lib/contacto.ts`).
 *
 * Es un documento para leer: un h1, sus secciones como regiones con nombre (h2) y nada más. Sin la
 * nav de anclas del header (no hay secciones a las que ir) ni "Ver la app en acción".
 */
import { privacidad, terminos } from '../content/legal.ts';
import { marca } from '../content/sitio.ts';
import { configurarContacto } from '../lib/contacto.ts';
import { configurarSeo } from '../lib/seo.ts';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  documento: 'privacidad' | 'terminos';
}

const { documento } = Astro.props;

const seo = configurarSeo(import.meta.env.PUBLIC_SITE_URL, import.meta.env.LANDING_INDEXABLE);
const contacto = configurarContacto(
  import.meta.env.PUBLIC_CONTACT_NAME,
  import.meta.env.PUBLIC_CONTACT_EMAIL,
  seo.indexable,
);
const doc = documento === 'privacidad' ? privacidad(contacto) : terminos(contacto);

/** El texto de un párrafo, con el email del contacto (si lo trae) como enlace `mailto:`. */
function partes(texto: string): (string | { email: string })[] {
  if (contacto === null || !texto.includes(contacto.email)) return [texto];
  const resultado: (string | { email: string })[] = [];
  const trozos = texto.split(contacto.email);
  trozos.forEach((trozo, i) => {
    if (i > 0) resultado.push({ email: contacto.email });
    if (trozo !== '') resultado.push(trozo);
  });
  return resultado;
}
---

<BaseLayout
  titulo={`${doc.titulo} · ${marca.nombre}`}
  descripcion={doc.descripcion}
  ruta={doc.ruta}
  nav={false}
  demo={false}
>
  <article class="contenedor documento">
    <div class="portada">
      <h1 class="titulo-seccion">{doc.titulo}</h1>
      <p class="actualizado">Última actualización: {doc.actualizado}</p>
      <p class="introduccion">{doc.introduccion}</p>
    </div>

    {doc.secciones.map((seccion) => (
      <section aria-labelledby={`${seccion.id}-titulo`}>
        <h2 id={`${seccion.id}-titulo`}>{seccion.titulo}</h2>
        {seccion.bloques.map((bloque) => {
          if (bloque.tipo === 'lista') {
            return (
              <ul>
                {bloque.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            );
          }
          if (bloque.tipo === 'enlace') {
            return (
              <p>
                <a href={bloque.href}>{bloque.texto}</a>
              </p>
            );
          }
          return (
            <p>
              {partes(bloque.texto).map((parte) =>
                typeof parte === 'string' ? (
                  parte
                ) : (
                  <a href={`mailto:${parte.email}`}>{parte.email}</a>
                ),
              )}
            </p>
          );
        })}
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  /* El documento va alineado con el header y el footer; sólo el texto se angosta para leerse bien. */
  .documento {
    padding-block: 3rem 4rem;
  }

  .portada,
  section {
    max-width: 46rem;
  }

  .portada {
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--wc-line);
  }

  .actualizado {
    margin: 1rem 0 0;
    color: var(--wc-text-muted);
    font-family: var(--wc-font-family);
    font-size: var(--wc-font-size-caption);
    text-transform: uppercase;
  }

  .introduccion {
    margin: 1.25rem 0 0;
    color: var(--wc-text-body);
    font-family: var(--wc-font-family-body);
    line-height: 1.75;
  }

  section {
    margin-top: 2.25rem;
  }

  h2 {
    margin: 0;
    font-size: var(--wc-font-size-heading);
    letter-spacing: 0.04em;
  }

  section p,
  section li {
    color: var(--wc-text-body);
    font-family: var(--wc-font-family-body);
    line-height: 1.75;
  }

  section p {
    margin: 0.75rem 0 0;
  }

  ul {
    margin: 0.75rem 0 0;
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.375rem;
  }

  li::marker {
    color: var(--wc-accent);
  }

  a {
    color: var(--wc-accent-text);
    text-underline-offset: 0.25em;
  }
</style>

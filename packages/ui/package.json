{
  "name": "@wasabi-cross/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Componentes Cross — librería de UI compartida. Sin lógica de negocio.",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/wasabi-cross-ui.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles/tokens.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@fontsource/share-tech-mono": "^5.3.0",
    "@fontsource/staatliches": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "^10.6.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@tanstack/charts": "^0.18.0",
    "@tanstack/react-charts": "^1.0.0",
    "d3-scale": "^4.0.2"
  }
}

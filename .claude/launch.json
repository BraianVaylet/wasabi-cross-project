{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ui-storybook",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wasabi-cross/ui", "storybook"],
      "port": 6006
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 5173
    },
    {
      "name": "api-efimera",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@wasabi-cross/api", "dev:ephemeral"],
      "port": 3100
    },
    {
      "name": "web-efimera",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@wasabi-cross/web",
        "exec",
        "vite",
        "--host",
        "127.0.0.1",
        "--port",
        "5174",
        "--strictPort"
      ],
      "env": { "VITE_API_URL": "http://127.0.0.1:3100" },
      "port": 5174
    }
  ]
}
